{
  "name": "peufmreader-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-offline-assets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:reader-regression": "playwright test e2e/reader-corpus-regression.spec.ts",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "epubjs": "0.3.93",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "^5.0.1"
  }
}
